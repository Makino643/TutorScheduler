# Copy this file to .env.docker and fill values.
# For LAN access from Mac, set NEXTAUTH_URL using this Windows PC LAN IP.
# Example: http://192.168.1.35:3000
NEXTAUTH_URL="http://YOUR_WINDOWS_LAN_IP:3000"

# Generate securely: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-random-secret"

# SQLite file is persisted via docker-compose volume mount: ./prisma -> /app/prisma
DATABASE_URL="file:/app/prisma/dev.db"

# Seed tutor account (run at container start)
SEED_TUTOR_EMAIL="shixian.liu643@outlook.com"
SEED_TUTOR_PASSWORD="Miqishmily5"
SEED_TUTOR_DISPLAY_NAME="Demo Tutor"

# iCal public feed token
ICAL_FEED_TOKEN="replace-with-strong-ical-token"

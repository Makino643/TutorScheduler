# SQLite path is relative to prisma/schema.prisma → default creates prisma/dev.db
DATABASE_URL="file:./dev.db"

# Base URL used by Auth.js callbacks (for LAN use set to your server URL)
# Example LAN: http://192.168.1.35:3000
NEXTAUTH_URL="http://localhost:3000"

# Generate: openssl rand -base64 32
# Required for production; CI sets a dummy value for builds.
# Dev-only placeholder (32+ chars). Replace in production: openssl rand -base64 32
AUTH_SECRET="local-dev-change-me-openssl-rand-base64-32chars-min"

# Used by `npm run db:seed` (Phase 1). Change password before any real data.
SEED_TUTOR_EMAIL="shixian.liu643@outlook.com"
SEED_TUTOR_PASSWORD="Miqishmily5"
SEED_TUTOR_DISPLAY_NAME="Demo Tutor"

# Public iCal feed token (used by GET /api/ical/[token])
ICAL_FEED_TOKEN="dev-ical-token-change-me"

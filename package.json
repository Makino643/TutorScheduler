{
  "name": "tutor-scheduler",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "concurrently \"next dev -p 3989\" \"wait-on http://127.0.0.1:3989 && electron .\"",
    "desktop:build": "next build && node scripts/prepare-standalone.js",
    "desktop:pack": "npm run desktop:build && electron-builder --publish never",
    "desktop:pack:fresh": "powershell -ExecutionPolicy Bypass -File ./scripts/desktop-pack-fresh.ps1",
    "desktop:release": "npm run desktop:build && electron-builder --publish always",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "validate:phase1": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "validate:phase2": "npm run test && npm run validate:phase1",
    "validate:phase3": "npm run validate:phase2",
    "validate:phase4": "npm run test && npm run lint && npm run typecheck && npm run build",
    "validate:phase5": "npm run test && npm run lint && npm run typecheck && npm run build",
    "validate:phase6": "npm run test && npm run lint && npm run typecheck && npm run build",
    "validate:phase7": "npm run test && npm run lint && npm run typecheck && npm run build",
    "validate:phase10": "npm run test && npm run lint && npm run typecheck && npm run build",
    "validate:phase11": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.tutorflow.app",
    "productName": "TutorFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "schema.prisma",
          "migrations/**/*",
          "dev.db"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/.prisma/**/*",
      "**/node_modules/@prisma/**/*",
      "**/.next/standalone/**/*",
      "**/.next/static/**/*",
      "**/public/**/*"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
